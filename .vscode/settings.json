{
    "python.analysis.typeCheckingMode": "strict",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticSeverityOverrides": {
        "reportUnknownMemberType": "none",
        "reportUnknownArgumentType": "none",
        "reportInvalidTypeArguments": "none",
        "reportAssignmentType": "none",
    },
    "ruff.lint.select": [
        "E",
        "W",
        "F",
        "I",
        "N",
        "UP",
        "B",
        "A",
        "YTT",
        "ASYNC",
        "S",
        "BLE",
        "C4",
        "PIE",
        "SIM",
        "RET",
        "ARG",
        "PTH",
        "ERA",
        "PL",
        "RUF",
        "PT",
        "ANN",
        "D101",
        "D102",
        "D103"
    ],
    "ruff.lint.ignore": [
        "E501",
        "ISC001",
        "COM812",
        "D203",
        "D213",
        "ANN101",
        "ANN102",
        "ANN201",
        "ANN204",
        "ERA001",
        "PLR0913",
        "PLR0912",
        "PLR0915",
        "PLR0911",
        "PLR2004",
        "PLW2901",
        "PLC0414",
        "RET504",
        "ARG002",
        "SIM108",
        "A003"
    ],
    "ruff.lint.per-file-ignores": {
        "tests/**/*.py": [
            "S101",
            "PLR2004",
            "A001",
            "ANN001",
            "ANN201"
        ],
        "test_*.py": [
            "S101",
            "PLR2004",
            "A001",
            "ANN001",
            "ANN201"
        ],
        "**/test_*.py": [
            "S101",
            "PLR2004",
            "A001",
            "ANN001",
            "ANN201"
        ],
        "scripts/**/*.py": [
            "T201"
        ],
        "cli.py": [
            "T201"
        ],
        "__init__.py": [
            "F401",
            "D104"
        ],
        "setup.py": [
            "D100"
        ],
        "conftest.py": [
            "D100"
        ],
        "vendor/**/*.py": [
            "ALL"
        ],
        "legacy/**/*.py": [
            "E",
            "W",
            "F"
        ]
    },
}